# lab-management-system-fastapi — 开发期环境变量模板
#
# L0.5 env 一致性门管理三件套：.env.example（dev）/.env.test（pytest）/.env.production（deploy）
# key 集合严格相等；secret 值由 deploy 脚本注入（不 commit 真密钥）。
# 键集 = deploy/*.sh printf 全集（check_deploy_parity 双向严格比对）；
# 键名照抄 lab-management-system-rails/springboot 镜像，fastapi 运行时读
# DATABASE_URL 单串 + flat JWT_* + LAB_SSO_*（src 直读 os.environ）。

# —— Server ——
SERVER_PORT=5207

# —— Database（lab_dev 数据库, 全家族统一 PG_* 五件套） ——
PG_HOST=100.79.128.25
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=qiand68+++
PG_DATABASE=lab_dev

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
# lab 自签 HS256 access/refresh token；SSO 链路 lab refresh token 内嵌 saas refresh token
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (直连 saas IdP, ADR-0009; 恒真链) ——
LAB_SAAS_BASE_URL=http://localhost:5101
LAB_SSO_LOGIN_URL=http://localhost:5101
LAB_SAAS_CLIENT_ID=lab-management
LAB_SAAS_CLIENT_SECRET=lab-management-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5202/login
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456
LAB_SAAS_SERVICE_CLIENT_ID=lab-management
LAB_AUTH_DEV_PASSWORD=dev123456

# —— CORS allowed origins (SSO 跨域用; 勿写成 saas 家族的 SAAS_CORS_*) ——
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5201,http://localhost:5202,http://localhost:5203,http://localhost:5101,http://localhost:5208

# —— 兼容 deploy 脚本（lab-management-system-fastapi.sh 用 DATABASE_URL 单串） ——
# 注: 运行时读 PG_* 五件套或 DATABASE_URL 单串；deploy 脚本从 PG_* 拼串注入。
DATABASE_URL=postgresql://postgres:qiand68%2B%2B%2B@100.79.128.25:5432/lab_dev
